{
  "family": "cogvideox",
  "label": "CogVideoX",
  "description": "CogVideoX text-to-video generation model by THUDM",
  "runner": "diffusers",
  "pipeline": {
    "class": "CogVideoXPipeline",
    "video_pipeline": true
  },
  "schedulers": {
    "cogvideox_ddim": "CogVideoXDDIMScheduler",
    "cogvideox_dpm": "CogVideoXDPMScheduler"
  },
  "default_scheduler": "cogvideox_ddim",
  "defaults": {
    "width": 720,
    "height": 480,
    "steps": 50,
    "cfg": 6.0,
    "num_frames": 49,
    "fps": 8,
    "max_seq": 226
  },
  "inputs": {
    "prompt": { "required": true, "type": "text" },
    "steps": { "required": false, "type": "int", "default": 50, "min": 1, "max": 200 },
    "cfg": { "required": false, "type": "float", "default": 6.0, "min": 1.0, "max": 30.0 },
    "seed": { "required": false, "type": "int", "default": -1, "min": -1, "max": 2147483647 },
    "num_frames": { "required": false, "type": "int", "default": 49, "min": 1, "max": 120 },
    "max_sequence_length": { "required": false, "type": "int", "default": 226 },
    "width": { "required": false, "type": "int", "default": 720, "min": 64, "max": 4096 },
    "height": { "required": false, "type": "int", "default": 480, "min": 64, "max": 4096 }
  },
  "output": { "type": "video", "mime": "video/mp4" },
  "variants": [
    {
      "key": "cogvideox",
      "name": "CogVideoX-2b",
      "hf_name": "THUDM/CogVideoX-2b",
      "type": "builtin",
      "size_gb": 5.2,
      "dtype": "bfloat16",
      "needs_token": false
    },
    {
      "key": "cogvideox-2b",
      "name": "CogVideoX-2b",
      "hf_name": "THUDM/CogVideoX-2b",
      "type": "builtin",
      "size_gb": 5.2,
      "dtype": "float16",
      "needs_token": false
    },
    {
      "key": "cogvideox-5b",
      "name": "CogVideoX-5b",
      "hf_name": "THUDM/CogVideoX-5b",
      "type": "builtin",
      "size_gb": 10.0,
      "dtype": "float16",
      "needs_token": false
    },
    {
      "key": "cogvideox-5b-i2v",
      "name": "CogVideoX-5b-I2V",
      "hf_name": "THUDM/CogVideoX-5b-I2V",
      "type": "builtin",
      "size_gb": 10.0,
      "dtype": "bfloat16",
      "needs_token": false,
      "pipeline": {
        "class": "CogVideoXImageToVideoPipeline",
        "video_pipeline": true
      },
      "defaults": {
        "width": 720,
        "height": 480,
        "steps": 50,
        "cfg": 6.0,
        "num_frames": 49,
        "fps": 8,
        "max_seq": 226,
        "strength": 0.8
      },
      "inputs": {
        "image": { "required": true, "type": "image" },
        "steps": { "required": false, "type": "int", "default": 50, "min": 1, "max": 200 },
        "cfg": { "required": false, "type": "float", "default": 6.0, "min": 1.0, "max": 30.0 },
        "seed": { "required": false, "type": "int", "default": 0, "min": 0, "max": 2147483647 },
        "num_frames": { "required": false, "type": "int", "default": 49, "min": 1, "max": 120 },
        "width": { "required": false, "type": "int", "default": 720, "min": 64, "max": 4096 },
        "height": { "required": false, "type": "int", "default": 480, "min": 64, "max": 4096 },
        "fps": { "required": false, "type": "int", "default": 8 },
        "max_sequence_length": { "required": false, "type": "int", "default": 226 },
        "strength": { "required": false, "type": "float", "default": 0.8, "min": 0, "max": 1 }
      }
    }
  ]
}
