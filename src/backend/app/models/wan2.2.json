{
  "family": "wan2.2",
  "label": "Wan2.2",
  "description": "Wan2.2 video generation by Alibaba (needs custom runner)",
  "runner": "wan2.2",
  "runner_install": {
    "source": "pip",
    "package": "stable-diffusion-cpp-python",
    "url": "https://github.com/leejet/stable-diffusion.cpp",
    "entry": ""
  },
  "pipeline": { "video_pipeline": true },
  "schedulers": {},
  "default_scheduler": null,
  "defaults": {
    "steps": 50,
    "cfg": 5.0
  },
  "inputs": {
    "prompt": { "required": true, "type": "text" },
    "image": { "required": false, "type": "image" },
    "pose_video": { "required": false, "type": "video" },
    "face_video": { "required": false, "type": "video" },
    "background_video": { "required": false, "type": "video" },
    "mask_video": { "required": false, "type": "video" },
    "steps": { "required": false, "type": "int", "default": 50, "min": 1, "max": 200 },
    "cfg": { "required": false, "type": "float", "default": 5.0, "min": 1.0, "max": 30.0 },
    "seed": { "required": false, "type": "int", "default": 0, "min": 0, "max": 2147483647 },
    "strength": { "required": false, "type": "float", "default": 0.8, "min": 0, "max": 1 }
  },
  "output": { "type": "video", "mime": "video/mp4" },
  "variants": [
    {
      "key": "wan2.2-gguf",
      "name": "Wan2.2 TI2V 5B (GGUF)",
      "hf_name": "QuantStack/Wan2.2-TI2V-5B-GGUF",
      "type": "installable",
      "size_gb": 8.5,
      "dtype": "q4_k_m",
      "needs_token": false
    }
  ]
}
