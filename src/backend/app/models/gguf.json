{
  "family": "gguf",
  "label": "GGUF / Ollama",
  "description": "Text generation models running via Ollama (GGUF format)",
  "runner": "gguf",
  "defaults": {
    "temperature": 0.7,
    "max_tokens": 2048,
    "top_p": 0.9,
    "top_k": 40,
    "seed": 0
  },
  "inputs": {
    "prompt": { "required": true, "type": "text" },
    "system_prompt": { "required": false, "type": "text" },
    "temperature": { "required": false, "type": "float", "default": 0.7, "min": 0.0, "max": 2.0 },
    "max_tokens": { "required": false, "type": "int", "default": 2048, "min": 1, "max": 65536 },
    "top_p": { "required": false, "type": "float", "default": 0.9, "min": 0.0, "max": 1.0 },
    "top_k": { "required": false, "type": "int", "default": 40, "min": 0, "max": 100 },
    "seed": { "required": false, "type": "int", "default": 0, "min": 0 }
  },
  "output": { "type": "text", "mime": "text/plain" },
  "variants": [
    {
